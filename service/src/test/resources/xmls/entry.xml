		<column name="AnalysisEntryText" size="60" text="@tEntry.AnalysisEntryKey">
			<text length="10"/>
		</column>
		<column name="VehicleCount" size="40" text="@tEntry.VehicleCount" total="true">
			<number/>
		</column>
		<column name="NoticedStandardVolume" size="60" text="@tEntry.NoticedStandardVolume" total="true">
			<number/>
		</column>
		<column name="NoticedAmbientVolume" size="60" text="@tEntry.NoticedAmbientVolume" total="true">
			<number/>
		</column>
		<column name="NoticedMass" size="60" text="@tEntry.NoticedMass" total="true">
			<number/>
		</column>
		<column name="NoticedWeight" size="60" text="@tEntry.NoticedWeight" total="true">
			<number/>
		</column>
		<column name="PreviousDocumentReference" size="60" text="@tEntry.PreviousDocumentReference">
			<text length="20"/>
		</column>
		<column name="BatchNumber" text="@tEntry.BatchNumber">
			<text length="20"/>
		</column>
		<column name="Remarks" text="@tEntry.Remarks">
			<text length="50"/>
		</column>
		<column name="SpecialRemarks" text="@tEntry.SpecialRemarks">
			<text length="50"/>
		</column>
		<column name="ExpectedDateOfArrival" size="60" text="@tEntry.ExpectedDateOfArrival">
			<date-time/>
		</column>
		<column name="UnloadingPlant" text="@tEntry.UnloadingPlant">
			<text length="20"/>
		</column>
		<column name="UnloadingStartDate" size="60" text="@tEntry.UnloadingStartDate">
			<date-time/>
		</column>
		<column name="UnloadingStopDate" size="60" text="@tEntry.UnloadingStopDate">
			<date-time/>
		</column>
		<column name="SupplierCompany" text="@tEntry.SupplierCompany">
