		</column>
		<column name="Closed" size="60" text="@tEntry.Closed">
			<boolean/>
		</column>
		<column name="AmbientVolume" size="60" text="@AmbientVolume" total="true">
			<number/>
		</column>
		<column name="ModeOfTransportTypeText" size="60" text="@tModeOfTransportType">
			<text length="60"/>
		</column>
		<column name="Mass" size="60" text="@tStock.Mass" total="true">
			<number/>
		</column>
		<column name="TransportName" size="60" text="@tEntry.TransportName">
			<text length="60"/>
		</column>
		<column name="Gallons" size="60" text="@Gallons" total="true">
