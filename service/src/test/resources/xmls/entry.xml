<?xml version="1.0" encoding="UTF-8"?><form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" icon="Entry.ico" title="@tStockEntry.Administration" xsi:noNamespaceSchemaLocation="../../../../../../ch.minova.install/src/ch/minova/install/xsd/XMLForm.xsd" helper-class="ch.minova.tta.entry.helper.EntryHelper">
	
