		<optionpage icon="ParameterPage.ico"
			id="tShipment.defuelling" procedure-suffix="LuDefuellingRefuelling"
			text="Disposition">
			<field key-type="primary" map-to="KeyLong" name="ShipmentKey"
				sql-index="0" visible="false">
				<number />
			</field>
			<field name="DefuellingKey" sql-index="1" text="Enttankung">
				<lookup procedure-prefix="spLuDefuellingRefuelling">
					<param field-name="ShipmentKey" />
				</lookup>
			</field>
			<field name="AmbientTemperature" number-columns-spanned="4"
				read-only="false" required="false" sql-index="2" text="Temperatur">
				<number decimals="1" />
				<dynamic property="required">Defuelling == 1 &amp;&amp;
					DefuellingIsClosed == 1</dynamic>
			</field>
			<field name="AmbientDensity" read-only="false" sql-index="3"
				text="Spez. Gewicht">
				<number decimals="1" />
				<dynamic property="required">Defuelling == 1 &amp;&amp;
					DefuellingIsClosed == 1</dynamic>
			</field>
			<field name="StandardDensity" read-only="false" sql-index="4"
				text="Dichte 15°C">
				<number decimals="1" />
				<dynamic property="required">Defuelling == 1 &amp;&amp;
					DefuellingIsClosed == 1</dynamic>
			</field>
			<field name="Defuelling" sql-index="5" visible="false">
				<number />
			</field>
			<field name="DefuellingIsClosed" sql-index="6" visible="false">
				<number />
			</field>
			<field name="ItemKey" sql-index="7" visible="false">
				<number />
			</field>
			<events>
				<value-change field-name="DefuellingKey" type="USER">
					<jscript>
						if (DefuellingKey != null) {
						ambientTemperature = tools.getSQLValue('tShipment', 'KeyLong', DefuellingKey,
						'AmbientTemperature');
						ambientDensity = tools.getSQLValue('tShipment', 'KeyLong', DefuellingKey,
						'AmbientDensity');
						standardDensity = tools.getSQLValue('tShipment', 'KeyLong', DefuellingKey,
						'StandardDensity');
						tools.set('AmbientTemperature', ambientTemperature);
						tools.set('AmbientDensity', ambientDensity);
						tools.set('StandardDensity', standardDensity);
						}
					</jscript>
				</value-change>
				<value-change field-name="AmbientDensity" type="USER">
					<instance class="ch.minova.iso.JIso" object-name="iso" />
					<jscript>
						if (AmbientDensity != null &amp;&amp; AmbientTemperature != null
						&amp;&amp; StandardDensity == null) {
						iso.calculateStandardDensity(AmbientDensity, AmbientTemperature,
						ItemKey);
						tools.set('StandardDensity', iso.getStandardDensity())
						} else if (AmbientDensity == null &amp;&amp; AmbientTemperature !=
						null &amp;&amp; StandardDensity != null) {
						iso.calculateAmbientDensity(StandardDensity, AmbientTemperature,
						ItemKey);
						tools.set('AmbientDensity', iso.getAmbientDensity())
						}
					</jscript>
				</value-change>
